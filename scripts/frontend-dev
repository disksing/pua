#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
workspace=${1:-}

if [ -z "$workspace" ]; then
	echo "usage: scripts/frontend-dev /path/to/isolated/AgentWorkspace" >&2
	exit 2
fi

pua_dev_runtime=$(mktemp -d "${TMPDIR:-/tmp}/pua-frontend-dev.XXXXXX")
mkdir -p "$pua_dev_runtime/agenthub"
if [ ! -f "$root/agenthub/web/static/index.html" ]; then
	npm --prefix "$root/web" run build:agenthub
fi
go -C "$root" build -o "$pua_dev_runtime/pua" ./cli/cmd/pua
PUA_SERVE_CONFIG="$pua_dev_runtime/serve.json" \
AGENTHUB_HOME="$pua_dev_runtime/agenthub" \
"$pua_dev_runtime/pua" serve --addr=127.0.0.1:4936 --workspace="$workspace" &
pua_dev_server_pid=$!
cleanup() {
	kill "$pua_dev_server_pid" 2>/dev/null || true
	wait "$pua_dev_server_pid" 2>/dev/null || true
	rm -rf "$pua_dev_runtime"
}
trap cleanup EXIT HUP INT TERM

npm --prefix "$root/web" run dev

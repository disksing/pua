#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out_dir=${1:-bin}

case "$out_dir" in
/*) out_path=$out_dir ;;
*) out_path=$root/$out_dir ;;
esac

branch=$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null || printf unknown)
if [ "$branch" = "HEAD" ] || [ -z "$branch" ]; then
	branch=unknown
fi

sha=$(git -C "$root" rev-parse HEAD 2>/dev/null || printf unknown)
if [ -z "$sha" ]; then
	sha=unknown
fi

ldflags="-X github.com/disksing/pua/internal/buildinfo.Branch=$branch -X github.com/disksing/pua/internal/buildinfo.SHA=$sha"

mkdir -p "$out_path"
cd "$root"
npm --prefix web ci
npm --prefix web run check
npm --prefix web run build
go build -tags embed_frontend -ldflags "$ldflags" -o "$out_path/pua" ./cli/cmd/pua
go build -tags embed_frontend -ldflags "$ldflags" -o "$out_path/agenthub" ./agenthub/cmd/agenthub

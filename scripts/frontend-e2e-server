#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
port=${PUA_E2E_PORT:-14936}
temp_root=${TMPDIR:-/tmp}
temp_root=${temp_root%/}
runtime_dir=${PUA_E2E_RUNTIME_DIR:-}
if [ -n "$runtime_dir" ]; then
	case "$runtime_dir" in
	"$temp_root"/pua-frontend-e2e-"$port") ;;
	*) echo "PUA_E2E_RUNTIME_DIR must be $temp_root/pua-frontend-e2e-$port" >&2; exit 2 ;;
	esac
	rm -rf "$runtime_dir"
	mkdir -p "$runtime_dir"
else
	runtime_dir=$(mktemp -d "$temp_root/pua-frontend-e2e.XXXXXX")
fi
workspace_dir="$runtime_dir/workspace"
agenthub_data_dir="$runtime_dir/agenthub"
binary_path="$runtime_dir/pua"

cleanup() {
	rm -rf "$runtime_dir"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$workspace_dir" "$agenthub_data_dir"

# The embedded frontend build output is not committed; build it on demand so a
# fresh checkout can run e2e tests without a manual frontend build.
if [ ! -f "$root/web/static/assets/pua-app.js" ]; then
	npm --prefix "$root/web" run build
fi
if [ ! -f "$root/agenthub/web/static/index.html" ]; then
	npm --prefix "$root/web" run build:agenthub
fi

go -C "$root" build -o "$binary_path" ./cli/cmd/pua
(
	cd "$workspace_dir"
	"$binary_path" init --language=en
)

PUA_SERVE_CONFIG="$runtime_dir/serve.json" \
AGENTHUB_HOME="$agenthub_data_dir" \
"$binary_path" serve --addr="127.0.0.1:$port" --workspace="$workspace_dir"

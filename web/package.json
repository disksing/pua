{
  "name": "pua-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build:pua && npm run build:agenthub",
    "build:pua": "vite build",
    "build:agenthub": "vite build --config vite.agenthub.config.ts && node ../agenthub/frontend/scripts/embed-client.mjs && node ../agenthub/frontend/scripts/prepare-sites-build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run && npm run test:sites",
    "test:sites": "node ../agenthub/frontend/tests/sites-worker.test.mjs",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.10.1",
    "codemirror": "^6.0.2",
    "jsdom": "30.0.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

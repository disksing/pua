#!/bin/sh
set -eu

die() {
	printf '%s\n' "release-local: $*" >&2
	exit 1
}

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
plan=$($root/scripts/release-plan)
release=$(printf '%s\n' "$plan" | sed -n 's/^release=//p')
pua=$(printf '%s\n' "$plan" | sed -n 's/^pua=//p')
agenthub=$(printf '%s\n' "$plan" | sed -n 's/^agenthub=//p')
macapp=$(printf '%s\n' "$plan" | sed -n 's/^macapp=//p')
[ -n "$release" ] || die "release plan did not return a version"

output_dir=${1:-dist/v$release}
case "$output_dir" in
/*) output=$output_dir ;;
*) output=$root/$output_dir ;;
esac
[ ! -e "$output" ] || die "output already exists: $output"

if [ "$pua" = true ]; then
	"$root/scripts/release-component" pua "$release" "$output/pua"
fi
if [ "$agenthub" = true ]; then
	"$root/scripts/release-component" agenthub "$release" "$output/agenthub"
fi
if [ "$macapp" = true ]; then
	"$root/scripts/release-macapp" "$release" "$output/macapp"
fi

printf '%s\n' "local release v$release written to $output"

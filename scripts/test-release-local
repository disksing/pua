#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/pua-release-test.XXXXXX")
cleanup() {
	rm -rf -- "$test_root"
}
trap cleanup EXIT HUP INT TERM

fixture=$test_root/repository
mkdir -p "$fixture/scripts" "$fixture/versions" "$test_root/bin"
cp "$root/scripts/release-plan" "$root/scripts/release-local" "$root/scripts/version" "$fixture/scripts/"
cp "$root/versions/"* "$fixture/versions/"

cat >"$test_root/bin/git" <<'EOF'
#!/bin/sh
case "$*" in
*"rev-parse --short=12 HEAD"*) echo 0123456789ab ;;
*"rev-list --count HEAD"*) echo 42 ;;
*"status --porcelain"*) exit 0 ;;
*) echo "unexpected git arguments: $*" >&2; exit 1 ;;
esac
EOF

cat >"$fixture/scripts/release-component" <<'EOF'
#!/bin/sh
set -eu
mkdir -p "$3"
printf '%s %s\n' "$1" "$2" >>"$PUA_RELEASE_TEST_LOG"
printf 'artifact\n' >"$3/$1-artifact"
EOF

cat >"$fixture/scripts/release-macapp" <<'EOF'
#!/bin/sh
set -eu
mkdir -p "$2"
printf 'macapp %s\n' "$1" >>"$PUA_RELEASE_TEST_LOG"
printf 'artifact\n' >"$2/macapp-artifact"
EOF
chmod +x "$test_root/bin/git" "$fixture/scripts/"*

assert_line() {
	text=$1
	expected=$2
	printf '%s\n' "$text" | grep -Fxq "$expected" || {
		printf 'missing expected line: %s\n%s\n' "$expected" "$text" >&2
		exit 1
	}
}

plan=$($fixture/scripts/release-plan v0.1.0)
assert_line "$plan" release=0.1.0
assert_line "$plan" pua=true
assert_line "$plan" agenthub=true
assert_line "$plan" macapp=false

printf '0.2.0\n' >"$fixture/versions/release"
printf '0.2.0\n' >"$fixture/versions/pua"
plan=$($fixture/scripts/release-plan v0.2.0)
assert_line "$plan" pua=true
assert_line "$plan" agenthub=false
assert_line "$plan" macapp=false

if "$fixture/scripts/release-plan" 0.2.0 >/dev/null 2>&1; then
	echo "tag without v prefix unexpectedly succeeded" >&2
	exit 1
fi
if "$fixture/scripts/release-plan" pua-v0.2.0 >/dev/null 2>&1; then
	echo "component-prefixed tag unexpectedly succeeded" >&2
	exit 1
fi

for component in pua agenthub macapp; do
	version=$(PATH="$test_root/bin:$PATH" "$fixture/scripts/version" "$component")
	case "$version" in
	0.2.0-dev.42+g0123456789ab) ;;
	*) echo "unexpected $component development version: $version" >&2; exit 1 ;;
	esac
done
[ "$(PATH="$test_root/bin:$PATH" "$fixture/scripts/version" pua stable)" = 0.2.0 ]
[ "$(PATH="$test_root/bin:$PATH" "$fixture/scripts/version" agenthub stable)" = 0.1.0 ]

log=$test_root/release.log
PATH="$test_root/bin:$PATH" PUA_RELEASE_TEST_LOG="$log" "$fixture/scripts/release-local" "$test_root/pua-only" >/dev/null
[ "$(cat "$log")" = "pua 0.2.0" ] || { echo "local release selected the wrong components" >&2; exit 1; }

printf '0.2.0\n' >"$fixture/versions/agenthub"
printf '0.2.0\n' >"$fixture/versions/macapp"
: >"$log"
PATH="$test_root/bin:$PATH" PUA_RELEASE_TEST_LOG="$log" "$fixture/scripts/release-local" "$test_root/all" >/dev/null
[ "$(wc -l <"$log" | tr -d ' ')" -eq 3 ] || { echo "local release did not select all components" >&2; exit 1; }

printf '0.3.0\n' >"$fixture/versions/agenthub"
if "$fixture/scripts/release-plan" v0.2.0 >/dev/null 2>&1; then
	echo "component newer than the release unexpectedly succeeded" >&2
	exit 1
fi

printf '0.3.0\n' >"$fixture/versions/release"
printf '0.2.0\n' >"$fixture/versions/agenthub"
if "$fixture/scripts/release-plan" v0.3.0 >/dev/null 2>&1; then
	echo "release without a selected component unexpectedly succeeded" >&2
	exit 1
fi

printf '01.3.0\n' >"$fixture/versions/release"
if "$fixture/scripts/release-plan" v01.3.0 >/dev/null 2>&1; then
	echo "version with a leading zero unexpectedly succeeded" >&2
	exit 1
fi

echo "release planning tests passed"
